+EPLB_TRAINING_STRATEGY_KEY = "_training_strategy"
+EPLB_PER_EXPERT_WEIGHT_RE = re.compile(
+    r"(?P<prefix>.*(?:^|\.)layers\.(?P<layer_id>\d+)\.mlp\.experts\.)"
+    r"(?P<expert_id>\d+)(?P<suffix>\..*)$"
