diff --git a/verl/utils/moe_eplb.py b/verl/utils/moe_eplb.py
new file mode 100644
index 00000000..9282c4c3
--- /dev/null
+++ b/verl/utils/moe_eplb.py
@@ -0,0 +1,106 @@
+import json
+import logging
+import os
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+EMPTY_PATH_VALUES = {"", "None", "none", "null"}
+
+
+def _to_int(value: Any, name: str) -> int:
+    try:
+        return int(value)
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"{name} must be an integer, got {value!r}") from exc
+
+
+def load_strategy_from_path(strategy_path: Optional[str]) -> Optional[dict[str, Any]]:
+    if strategy_path is None:
+        return None
+    strategy_path = str(strategy_path).strip()
+    if strategy_path in EMPTY_PATH_VALUES:
+        return None
+    with open(strategy_path, "r", encoding="utf-8") as f:
+        return json.load(f)
+
+
+def _normalize_layer(layer: dict[str, Any]) -> tuple[int, dict[int, list[int]]]:
+    if not isinstance(layer, dict):
+        raise ValueError(f"layer entry must be a dict, got {type(layer).__name__}")
+    layer_id = _to_int(layer.get("layer_id"), "layer_id")
+    device_list = layer.get("device_list")
+    if not isinstance(device_list, list):
+        raise ValueError(f"layer {layer_id} device_list must be a list")
+
+    devices = {}
+    for device in device_list:
+        if not isinstance(device, dict):
+            raise ValueError(f"layer {layer_id} device entry must be a dict")
+        device_id = _to_int(device.get("device_id"), "device_id")
+        experts = device.get("device_expert")
+        if not isinstance(experts, list):
+            raise ValueError(f"layer {layer_id}, device {device_id} device_expert must be a list")
+        if device_id in devices:
+            raise ValueError(f"layer {layer_id} has duplicate device id {device_id}")
+        devices[device_id] = [_to_int(expert, "expert_id") for expert in experts]
+    return layer_id, devices
+
+
+def validate_eplb_strategy(
+    strategy: dict[str, Any],
+    *,
+    num_experts: Optional[int] = None,
+    device_count: Optional[int] = None,
+) -> dict[int, dict[int, list[int]]]:
+    if not isinstance(strategy, dict):
+        raise ValueError("strategy must be a dict")
+
+    layer_list = strategy.get("layer_list")
+    if not isinstance(layer_list, list):
+        raise ValueError("strategy layer_list must be a list")
+
+    moe_layer_count = _to_int(strategy.get("moe_layer_count", len(layer_list)), "moe_layer_count")
+    if moe_layer_count != len(layer_list):
+        raise ValueError(
+            f"moe_layer_count ({moe_layer_count}) must match layer_list length ({len(layer_list)})"
+        )
+
+    normalized: dict[int, dict[int, list[int]]] = {}
+    for layer in layer_list:
+        layer_id, devices = _normalize_layer(layer)
+        if layer_id in normalized:
+            raise ValueError(f"duplicate layer_id {layer_id}")
+        if device_count is not None:
+            expected_devices = list(range(device_count))
+            actual_devices = sorted(devices)
+            if actual_devices != expected_devices:
+                raise ValueError(
+                    f"layer {layer_id} device count or ids mismatch: expected {expected_devices}, got {actual_devices}"
+                )
+
+        flattened = [expert for experts in devices.values() for expert in experts]
+        if num_experts is not None:
+            expected_experts = list(range(num_experts))
+            if sorted(flattened) != expected_experts:
+                raise ValueError(
+                    f"layer {layer_id} must contain every expert id in [0, {num_experts}) exactly once"
+                )
+        elif len(flattened) != len(set(flattened)):
+            raise ValueError(f"layer {layer_id} must not contain duplicate expert ids")
+
+        normalized[layer_id] = devices
+    return normalized
+
+
+def strategy_to_placement(
+    strategy: dict[str, Any],
+    *,
+    num_experts: Optional[int] = None,
+    device_count: Optional[int] = None,
+) -> dict[int, dict[int, list[int]]]:
+    normalized = validate_eplb_strategy(strategy, num_experts=num_experts, device_count=device_count)
+    return {
+        layer_id: {device_id: list(experts) for device_id, experts in sorted(devices.items())}
+        for layer_id, devices in sorted(normalized.items())
+    }
