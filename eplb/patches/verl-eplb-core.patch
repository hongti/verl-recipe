+def _eplb_layer_id_from_weight_name(name: str) -> Optional[int]:
+    if re.search(r"\.mlp\.experts\.\d+\.", name):
+        return None
+
+    match = re.search(r"(?:^|\.)layers\.(\d+)\.mlp\.experts(?:\.|$)", name)
+    if match is None:
+        return None
+    return int(match.group(1))
+
+
+def _eplb_layer_expert_order(eplb_strategy: dict, layer_id: int) -> Optional[list[int]]:
+    if not isinstance(eplb_strategy, dict):
+        return None
+
+    for layer_config in eplb_strategy.get("layer_list", []):
+        if layer_config.get("layer_id") != layer_id:
+            continue
+        device_list = sorted(
+            layer_config.get("device_list", []),
+            key=lambda device: int(device.get("device_id", 0)),
+        )
+        expert_order: list[int] = []
+        for device in device_list:
+            expert_order.extend(int(expert) for expert in device.get("device_expert", []))
+        return expert_order
+    return None
+
+
+def _remap_eplb_per_expert_weight_name_with_reason(
+    name: str,
+    eplb_strategy: Optional[dict],
+) -> tuple[str, str, dict]:
+    match = EPLB_PER_EXPERT_WEIGHT_RE.match(name)
+    if match is None:
+        return name, "not_per_expert_name", {}
+
+    layer_id = int(match.group("layer_id"))
+    exported_expert_id = int(match.group("expert_id"))
+    source_strategy = eplb_strategy.get(EPLB_TRAINING_STRATEGY_KEY) if isinstance(eplb_strategy, dict) else None
+    source_order = _eplb_layer_expert_order(source_strategy, layer_id) if isinstance(source_strategy, dict) else None
+    if source_order is None:
+        return name, "per_expert_no_source_strategy", {"layer": layer_id, "expert": exported_expert_id}
+    if exported_expert_id >= len(source_order):
+        return (
+            name,
+            "per_expert_source_len_mismatch",
+            {"layer": layer_id, "expert": exported_expert_id, "source_len": len(source_order)},
+        )
+
+    logical_expert_id = int(source_order[exported_expert_id])
+    if logical_expert_id == exported_expert_id:
+        return name, "per_expert_identity", {"layer": layer_id, "expert": exported_expert_id}
+
+    new_name = f"{match.group('prefix')}{logical_expert_id}{match.group('suffix')}"
+    return (
+        new_name,
+        "per_expert_renamed",
+        {"layer": layer_id, "from": exported_expert_id, "to": logical_expert_id},
+    )
+
+
+def _reorder_eplb_expert_weight_tensor(
+    name: str,
+    tensor: torch.Tensor,
+    eplb_strategy: Optional[dict],
+) -> torch.Tensor:
+    new_tensor, _, _ = _reorder_eplb_expert_weight_tensor_with_reason(name, tensor, eplb_strategy)
+    return new_tensor
+
+
+def _reorder_eplb_expert_weight_tensor_with_reason(
+    name: str,
+    tensor: torch.Tensor,
+    eplb_strategy: Optional[dict],
+) -> tuple[torch.Tensor, str, dict]:
+    """Restore fused expert tensors to logical expert order before vLLM loading."""
+    if not isinstance(eplb_strategy, dict) or not isinstance(tensor, torch.Tensor) or tensor.dim() == 0:
+        return tensor, "invalid_input", {"is_tensor": isinstance(tensor, torch.Tensor)}
+
+    layer_id = _eplb_layer_id_from_weight_name(name)
+    if layer_id is None:
+        reason = "per_expert_name" if re.search(r"\.mlp\.experts\.\d+\.", name) else "not_expert_param"
+        return tensor, reason, {"shape": list(tensor.shape)}
+
+    source_strategy = eplb_strategy.get(EPLB_TRAINING_STRATEGY_KEY)
+    source_order = _eplb_layer_expert_order(source_strategy, layer_id) if isinstance(source_strategy, dict) else None
+    if source_order is None:
+        return tensor, "fused_no_source_strategy", {"layer": layer_id, "shape": list(tensor.shape)}
+    if len(source_order) != tensor.shape[0]:
+        return (
+            tensor,
+            "source_len_mismatch",
+            {
+                "layer": layer_id,
+                "shape0": int(tensor.shape[0]),
+                "source_len": len(source_order),
+                "shape": list(tensor.shape),
+            },
+        )
+
+    source_index_by_expert = {expert: idx for idx, expert in enumerate(source_order)}
+    try:
+        gather_index = [source_index_by_expert[expert] for expert in range(tensor.shape[0])]
+    except KeyError:
+        return (
+            tensor,
+            "source_missing_logical_expert",
+            {"layer": layer_id, "source_head": source_order[:8]},
+        )
+
+    if gather_index == list(range(tensor.shape[0])):
+        return tensor, "identity_order", {"layer": layer_id, "shape": list(tensor.shape)}
+
+    index_tensor = torch.tensor(gather_index, dtype=torch.long, device=tensor.device)
+    return (
+        tensor.index_select(0, index_tensor).contiguous(),
+        "changed",
+        {"layer": layer_id, "shape": list(tensor.shape), "gather_head": gather_index[:8]},
+    )
+
+
+def _reorder_eplb_expert_weight_updates(
+    weights: list[tuple[str, torch.Tensor]],
+    eplb_strategy: Optional[dict],
+) -> list[tuple[str, torch.Tensor]]:
+    if not isinstance(eplb_strategy, dict):
+        return weights
+
+    reordered = []
+    for name, tensor in weights:
+        new_name, reason, _ = _remap_eplb_per_expert_weight_name_with_reason(name, eplb_strategy)
+        if reason == "not_per_expert_name":
+            new_tensor, _, _ = _reorder_eplb_expert_weight_tensor_with_reason(name, tensor, eplb_strategy)
+        else:
+            new_tensor = tensor
+        reordered.append((new_name, new_tensor))
+
+    return reordered
+
