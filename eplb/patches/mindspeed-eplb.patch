+            mlp.external_expert_placement_version = strategy_version
+        return _result(
+            True,
+            changed=False,
+            strategy_version=strategy_version,
+            message="expert placement is unchanged",
+        )
+
+    for layer_id in changed_layers:
+        mlp = layer_mlps[layer_id]
+        expert_weight_placement(mlp)
+
+    optimizers = _set_optimizer_mlp_map(model, optimizer)
+    for sub_optimizer in optimizers:
+        optimizer_config = getattr(sub_optimizer, "config", None)
+        reuse_fp32_param = getattr(
+            sub_optimizer,
+            "reuse_fp32_param",
+            getattr(
+                optimizer_config,
+                "reuse_fp32_param",
+                getattr(config, "reuse_fp32_param", False),
+            ),
+        )
+        relocate_expert_optimization_states(
+            sub_optimizer,
+            reuse_fp32_param=bool(reuse_fp32_param),
+            config=config,
+        )
+
+    for mlp in layer_mlps.values():
+        mlp.external_expert_placement_version = strategy_version
+        mlp.expert_placement_layer_permission = False
+    print_rank_0(
+        f"[expert placement] applied external strategy version={strategy_version}, "
+        f"changed_layers={sorted(changed_layers)}"
+    )
+    return _result(
+        True,
+        changed=True,
+        strategy_version=strategy_version,
+        changed_layers=sorted(changed_layers),
+        message="expert placement applied",
+    )
