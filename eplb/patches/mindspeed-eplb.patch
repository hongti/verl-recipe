+def set_expert_placement(model, optimizer, placement, strategy_version=None, config=None):
+    """Apply an externally generated expert placement to local MoE layers.
+
+    Args:
+        model: A model chunk or a list of model chunks.
+        optimizer: Optimizer whose expert states should follow the weight relocation.
+        placement (dict): Mapping from layer id to EP rank and logical expert ids.
+        strategy_version: Optional external strategy version to record on layers.
+        config: Optional Megatron/MindSpeed config object. When omitted, global
+        Megatron args are used.
+
+    Returns:
+        dict: Result containing success, changed, strategy_version, changed_layers,
+        and message fields. Validation failures return ``success=False`` before
+        changing expert weights, optimizer states, or router mappings.
+    """
+    config = config if config is not None else get_args()
+    if not getattr(config, "enable_external_expert_placement", False):
+        return _result(
+            False,
+            strategy_version=strategy_version,
+            message="external expert placement requires --enable-external-expert-placement",
+        )
+    if optimizer is None:
+        return _result(
+            False,
+            strategy_version=strategy_version,
+            message="optimizer is required for expert placement",
+        )
+
+    try:
+        normalized_placement = _normalize_placement(placement)
+        layer_mlps = {}
+        for layer_id, mlp in _iter_moe_mlps(model):
+            if layer_id in layer_mlps and layer_mlps[layer_id] is not mlp:
+                raise ValueError(f"multiple local MoE layers use layer_id {layer_id}")
+            layer_mlps[layer_id] = mlp
+        if not layer_mlps:
+            raise ValueError("model does not contain any local MoE layers")
+        external_mappings = _validate_and_build_external_mappings(
+            normalized_placement, layer_mlps
+        )
+        for mlp in layer_mlps.values():
+            current_version = getattr(mlp, "external_expert_placement_version", None)
+            if (
+                strategy_version is not None
+                and current_version is not None
+                and strategy_version < current_version
+            ):
+                raise ValueError(
+                    f"strategy version {strategy_version} is older than "
+                    f"applied version {current_version}"
+                )
+    except (TypeError, ValueError) as exc:
+        return _result(False, strategy_version=strategy_version, message=str(exc))
+
+    changed_layers = []
+    for layer_id, mlp in layer_mlps.items():
+        _ensure_external_placement_state(mlp)
+
+        mlp.router.send_map = mlp.expert_mapping
+        target_mapping = external_mappings[layer_id]
+        if torch.equal(mlp.expert_mapping, target_mapping):
+            continue
+        initialize_expert_placement_dispatcher(mlp, target_mapping)
+        if mlp.expert_placement_layer_permission:
+            changed_layers.append(layer_id)
+
+    if not changed_layers:
