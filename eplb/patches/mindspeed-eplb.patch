+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from mindspeed.core.transformer.moe.expert_placement import executor
+from mindspeed.core.transformer.moe.moe_utils import get_grouped_expert_params
+from mindspeed.features_manager.moe.experts_placement import ExpertsPlacementFeature
+
+
+def _make_mlp():
+    config = SimpleNamespace(
+        num_moe_experts=4,
+        num_experts=None,
+        moe_tp_extend_ep=False,
+        moe_grouped_gemm=False,
+    )
+    experts = SimpleNamespace(
+        num_local_experts=2,
+        weight1=torch.empty(1),
+    )
+    return SimpleNamespace(config=config, experts=experts, router=SimpleNamespace())
+
+
+def _make_te_grouped_mlp():
+    config = SimpleNamespace(
+        num_moe_experts=4,
+        num_experts=None,
+        moe_tp_extend_ep=False,
+        moe_grouped_gemm=True,
+    )
+    experts = SimpleNamespace(
+        num_local_experts=2,
+        linear_fc1=SimpleNamespace(
+            weight0=torch.empty(1),
+            weight1=torch.empty(1),
+        ),
+        linear_fc2=SimpleNamespace(
+            weight0=torch.empty(1),
+            weight1=torch.empty(1),
+        ),
+    )
+    return SimpleNamespace(config=config, experts=experts, router=SimpleNamespace())
+
+
+def _make_model(mlp):
+    layer = SimpleNamespace(layer_number=1, mlp=mlp)
+    decoder = SimpleNamespace(layers=[layer])
+    module = SimpleNamespace(decoder=decoder)
+    return [SimpleNamespace(module=SimpleNamespace(module=module))]
+
+
+def _make_relocate_args(**overrides):
+    args = {
+        "enable_external_expert_placement": True,
+        "enable_expert_placement": False,
+        "use_distributed_optimizer": True,
+        "moe_extended_tp": False,
+        "moe_tp_extend_ep": False,
+        "enable_fine_grained_expert_placement": False,
+    }
+    args.update(overrides)
+    return SimpleNamespace(**args)
+
+
+def test_external_placement_validate_args_accepts_supported_config():
+    ExpertsPlacementFeature().validate_args(_make_relocate_args())
+
+
+def test_native_placement_validate_args_keeps_tp_extend_ep():
+    ExpertsPlacementFeature().validate_args(
+        _make_relocate_args(
+            enable_external_expert_placement=False,
+            enable_expert_placement=True,
+            moe_tp_extend_ep=True,
+            expert_model_parallel_size=2,
+            expert_placement_freq=50,
+        )
+    )
+
+
+@pytest.mark.parametrize(
+    ("overrides", "message"),
+    [
+        ({"enable_expert_placement": True}, "--enable-expert-placement"),
+        ({"use_distributed_optimizer": False}, "--use-distributed-optimizer"),
+        ({"moe_extended_tp": True}, "--moe-extended-tp"),
+        ({"moe_tp_extend_ep": True}, "--moe-tp-extend-ep"),
+    ],
+)
+def test_external_placement_validate_args_rejects_unsupported_config(
+    overrides, message
+):
+    with pytest.raises(AssertionError, match=message):
+        ExpertsPlacementFeature().validate_args(_make_relocate_args(**overrides))
+
+
+def test_external_placement_builds_logical_to_physical_mapping(monkeypatch):
+    mlp = _make_te_grouped_mlp()
+    monkeypatch.setattr(
+        executor.parallel_state, "get_expert_model_parallel_world_size", lambda: 2
+    )
+
+    placement = executor._normalize_placement(
+        {
+            "0": {
+                "0": [0, 3],
+                "1": [1, 2],
+            }
+        }
+    )
+    mappings = executor._validate_and_build_external_mappings(placement, {0: mlp})
+
+    assert mappings[0].tolist() == [0, 2, 3, 1]
+
+
+def test_external_placement_rejects_legacy_grouped_mlp(monkeypatch):
