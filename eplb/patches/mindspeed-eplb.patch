+def _iter_te_grouped_expert_weight_tensors(experts):
+    for linear_name in ("linear_fc1", "linear_fc2"):
+        linear = getattr(experts, linear_name, None)
+        if linear is None:
+            continue
+        if hasattr(linear, "weight"):
+            yield linear.weight
+        for name in dir(linear):
+            if name.startswith("weight"):
+                weight = getattr(linear, name)
+                if torch.is_tensor(weight):
+                    yield weight
+
+
+def _get_expert_weight_device(experts):
+    for weight in _iter_te_grouped_expert_weight_tensors(experts):
+        return weight.device
+    raise ValueError(
+        "external expert placement requires TEGroupedMLP experts with "
+        "linear_fc1/linear_fc2 weights"
+    )
+
