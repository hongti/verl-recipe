+def _ensure_external_placement_state(mlp):
+    """Prepare the per-layer state required by expert relocation.
+
+    Args:
+        mlp: Local MoE MLP module to be relocated.
+
+    Raises:
+        ValueError: If the existing expert mapping size is invalid.
+    """
+    num_moe_experts = _get_num_moe_experts(mlp.config)
+    ep_world_size = _get_expert_placement_world_size(mlp)
+    num_local_experts = _get_local_expert_count(mlp)
+    device = _get_expert_weight_device(mlp.experts)
+
+    if not hasattr(mlp, "expert_mapping"):
+        mlp.expert_mapping = torch.arange(
+            num_moe_experts, dtype=torch.int, device=device
+        )
+    if mlp.expert_mapping.numel() != num_moe_experts:
+        raise ValueError(
+            f"expert_mapping contains {mlp.expert_mapping.numel()} entries, "
+            f"expected {num_moe_experts}"
+        )
+
+    mlp.ep_world_size = ep_world_size
+    if not hasattr(mlp, "input_splits_for_expert_placement"):
+        mlp.input_splits_for_expert_placement = np.zeros(ep_world_size, dtype=np.int32)
+    if not hasattr(mlp, "output_splits_for_expert_placement"):
+        mlp.output_splits_for_expert_placement = np.zeros(ep_world_size, dtype=np.int32)
+    if (
+        not hasattr(mlp, "local_resorted_relative_mapping_indices")
+        or mlp.local_resorted_relative_mapping_indices.numel() != num_local_experts
+    ):
+        mlp.local_resorted_relative_mapping_indices = torch.zeros(
+            num_local_experts, dtype=torch.int, device=device
+        )
+    if (
+        not hasattr(mlp, "new_local_expert_sorted_indices")
+        or mlp.new_local_expert_sorted_indices.numel() != num_local_experts
+    ):
+        mlp.new_local_expert_sorted_indices = torch.zeros(
+            num_local_experts, dtype=torch.int, device=device
+        )
+    mlp.expert_placement_layer_permission = False
+
