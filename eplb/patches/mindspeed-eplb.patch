+
+        def named_parameters(self):
+            return iter(
+                [
+                    (
+                        "module.module.decoder.layers.0.mlp.experts.weight1",
+                        expert_param,
+                    ),
+                    (
+                        "module.module.decoder.layers.0.mlp.experts.linear_fc1.weight0",
