+def _normalize_identifier(value, name):
+    if isinstance(value, bool):
+        raise ValueError(f"{name} must be an integer, got bool")
+    try:
+        normalized = int(value)
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"{name} must be an integer, got {value!r}") from exc
+    if str(normalized) != str(value) and not isinstance(value, int):
+        raise ValueError(f"{name} must be an integer, got {value!r}")
+    return normalized
+
+
+def _normalize_placement(placement):
+    """Normalize an external expert placement into integer ids.
+
+    Args:
+        placement (dict): Mapping from layer id to EP rank and logical expert ids.
+
+    Returns:
+        dict: Placement with integer layer ids, device ids, and expert ids.
+
+    Raises:
+        ValueError: If the placement structure or any identifier is invalid.
+    """
+    if not isinstance(placement, dict) or not placement:
+        raise ValueError("placement must be a non-empty dict")
+
+    normalized = {}
+    for layer_id, device_placement in placement.items():
+        layer_id = _normalize_identifier(layer_id, "layer_id")
+        if layer_id in normalized:
+            raise ValueError(f"duplicate layer_id {layer_id}")
+        if not isinstance(device_placement, dict) or not device_placement:
+            raise ValueError(f"placement for layer {layer_id} must be a non-empty dict")
+
+        normalized[layer_id] = {}
+        for device_id, experts in device_placement.items():
+            device_id = _normalize_identifier(device_id, "device_id")
+            if device_id in normalized[layer_id]:
+                raise ValueError(f"duplicate device_id {device_id} in layer {layer_id}")
+            if not isinstance(experts, (list, tuple)):
+                raise ValueError(
+                    f"experts for layer {layer_id}, device {device_id} must be a list"
+                )
+            normalized[layer_id][device_id] = [
+                _normalize_identifier(expert_id, "expert_id") for expert_id in experts
+            ]
+    return normalized
+
