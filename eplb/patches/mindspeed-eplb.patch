+def _validate_and_build_external_mappings(placement, layer_mlps):
+    """Validate placement and convert it to MindSpeed expert mappings.
+
+    Args:
+        placement (dict): Normalized placement keyed by layer id and EP rank.
+        layer_mlps (dict): Local MoE MLP modules keyed by zero-based layer id.
+
+    Returns:
+        dict: Target expert mappings keyed by layer id.
+
+    Raises:
+        ValueError: If placement does not match the local MoE topology.
+    """
+    mappings = {}
+    local_layer_ids = set(layer_mlps)
+    missing_layers = sorted(local_layer_ids - set(placement))
+    if missing_layers:
+        raise ValueError(f"placement is missing local MoE layers: {missing_layers}")
+
+    for layer_id, mlp in layer_mlps.items():
+        if getattr(mlp.config, "moe_tp_extend_ep", False):
+            raise ValueError(
+                "external expert placement does not support --moe-tp-extend-ep"
+            )
+        layer_placement = placement[layer_id]
+        ep_world_size = _get_expert_placement_world_size(mlp)
+        num_local_experts = _get_local_expert_count(mlp)
+        num_moe_experts = _get_num_moe_experts(mlp.config)
+        expected_devices = set(range(ep_world_size))
+        actual_devices = set(layer_placement)
+        if actual_devices != expected_devices:
+            raise ValueError(
+                f"layer {layer_id} device ids must be {sorted(expected_devices)}, "
+                f"got {sorted(actual_devices)}"
+            )
+        if num_moe_experts != ep_world_size * num_local_experts:
+            raise ValueError(
+                f"layer {layer_id} expects {num_moe_experts} experts, but topology "
+                f"provides {ep_world_size} devices * {num_local_experts} slots"
+            )
+        if (
+            hasattr(mlp, "expert_mapping")
+            and mlp.expert_mapping.numel() != num_moe_experts
+        ):
+            raise ValueError(
+                f"layer {layer_id} expert_mapping contains "
+                f"{mlp.expert_mapping.numel()} entries, expected {num_moe_experts}"
+            )
+
+        flattened = []
+        for device_id in range(ep_world_size):
+            experts = layer_placement[device_id]
+            if len(experts) != num_local_experts:
+                raise ValueError(
+                    f"layer {layer_id}, device {device_id} must contain "
+                    f"{num_local_experts} experts, got {len(experts)}"
+                )
+            flattened.extend(experts)
+
+        if sorted(flattened) != list(range(num_moe_experts)):
+            raise ValueError(
+                f"layer {layer_id} must contain every expert id in "
+                f"[0, {num_moe_experts}) exactly once"
+            )
+
+        device = _get_expert_weight_device(mlp.experts)
+        physical_to_logical = torch.tensor(flattened, dtype=torch.long, device=device)
+        mappings[layer_id] = torch.argsort(physical_to_logical).to(dtype=torch.int)
+    return mappings
+
