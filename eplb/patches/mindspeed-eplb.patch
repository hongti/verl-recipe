+def _unwrap_model_chunk(model_chunk):
+    module = model_chunk
+    visited = set()
+    while hasattr(module, "module") and id(module) not in visited:
+        visited.add(id(module))
+        module = module.module
+    if hasattr(module, "language_model"):
+        module = module.language_model
+    return module
+
+
+def _iter_moe_mlps(model):
+    """Iterate over local MoE MLP modules from Megatron model chunks.
+
+    Args:
+        model: A model chunk or a list of model chunks.
+
+    Yields:
+        tuple[int, object]: The zero-based layer id and its MoE MLP module.
+    """
+    model_chunks = model if isinstance(model, (list, tuple)) else [model]
+    seen = set()
+    for model_chunk in model_chunks:
+        module = _unwrap_model_chunk(model_chunk)
+        decoder = getattr(module, "decoder", None)
+        if decoder is not None:
+            for local_layer_id, layer in enumerate(decoder.layers):
+                mlp = getattr(layer, "mlp", None)
+                if mlp is None or not hasattr(mlp, "router") or id(mlp) in seen:
+                    continue
+                seen.add(id(mlp))
+                layer_number = getattr(layer, "layer_number", local_layer_id + 1)
+                yield int(layer_number) - 1, mlp
+
+        mtp = getattr(module, "mtp", None)
+        if mtp is None:
+            continue
+        for local_layer_id, mtp_layer in enumerate(mtp.layers):
+            layer = getattr(mtp_layer, "transformer_layer", None)
+            mlp = getattr(layer, "mlp", None)
+            if mlp is None or not hasattr(mlp, "router") or id(mlp) in seen:
+                continue
+            seen.add(id(mlp))
+            layer_number = getattr(layer, "layer_number", local_layer_id + 1)
+            yield int(layer_number) - 1, mlp
+
+
+def _get_num_moe_experts(config):
+    """Get the configured number of logical MoE experts.
+
+    Args:
+        config: The MoE module config.
+
+    Returns:
+        int: Number of logical MoE experts.
+
+    Raises:
+        ValueError: If expert count fields are missing or inconsistent.
+    """
+    num_moe_experts = getattr(config, "num_moe_experts", None)
+    num_experts = getattr(config, "num_experts", None)
+    if num_moe_experts is None:
+        num_moe_experts = num_experts
+    elif num_experts is not None and num_experts != num_moe_experts:
+        raise ValueError(
+            f"num_experts ({num_experts}) and num_moe_experts "
+            f"({num_moe_experts}) must be consistent"
+        )
+    if num_moe_experts is None:
+        raise ValueError("model config does not define num_moe_experts or num_experts")
+    return int(num_moe_experts)
+
+
+def _get_expert_placement_world_size(mlp):
+    return parallel_state.get_expert_model_parallel_world_size()
+
