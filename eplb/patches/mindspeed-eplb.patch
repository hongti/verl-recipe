+def _set_optimizer_mlp_map(model, optimizer):
+    """Ensure optimizers have the parameter-to-MLP mapping used by relocation.
+
+    Args:
+        model: A model chunk or a list of model chunks.
+        optimizer: Optimizer or chained optimizer.
+
+    Returns:
+        list: Optimizers with ``params_module_mlp_map`` initialized.
+    """
+    optimizers = (
+        optimizer.chained_optimizers
+        if hasattr(optimizer, "chained_optimizers")
+        else [optimizer]
+    )
+    params_module_mlp_map = {
+        param: item
+        for param, item in build_param_params_module_mlp_map(
+            model if isinstance(model, (list, tuple)) else [model]
+        ).items()
+        if _is_te_grouped_expert_optimizer_param(item[1])
+    }
+    for sub_optimizer in optimizers:
+        sub_optimizer.params_module_mlp_map = params_module_mlp_map
+    return optimizers
+
